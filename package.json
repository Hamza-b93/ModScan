{
  "name": "modscan",
  "version": "1.0.0",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --targets node20-win-x64   --output dist/modscan-win.exe",
    "build:linux": "pkg . --targets node20-linux-x64 --output dist/modscan-linux",
    "build:native": "pkg . --output dist/modscan"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/steamworks.js/dist/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "steamworks.js": "^0.3.1"
  },
  "volta": {
    "node": "26.2.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  },
  "overrides": {
    "@yao-pkg/pkg-fetch": "3.5.30"
  }
}
